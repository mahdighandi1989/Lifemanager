{"eval": "(async()=>{const w=ms=>new Promise(r=>setTimeout(r,ms));APP.ASSIST.toggle(false);APP.go(\"dossier\",APP.ASSIST.cur().id,null);await w(1000);{const el=[...document.querySelectorAll('#main *')].filter(e=>e.children.length<6&&e.getClientRects().length&&\"\\u0645\\u0646\\u062a\\u0638\\u0631|\\u0628\\u0631\\u06af\\u0647\\u0654\".split('|').some(t=>e.textContent.includes(t))).pop();if(el)el.scrollIntoView({block:'center'});}await w(300);return location.hash+' '+APP.state.view+' '+(APP.state.arg||'')})()"}