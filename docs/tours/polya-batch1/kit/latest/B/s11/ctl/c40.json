{"eval": "(()=>{const o=JSON.parse(localStorage.getItem('mla.records.v1'));const V=Object.values(o);const r=V.find(r=>r&&r.id===APP.state.arg);const b=r.live&&r.live.back||{};const C=V.filter(r=>r&&r.type==='case');return JSON.stringify({keys:Object.keys(r.live||{}),back:b}).slice(0,2500)+' ### CASES '+C.map(c=>c.id+'|'+c.title+'|st='+c.status+'|out='+JSON.stringify(c.outcome||null).slice(0,200)).join('\\n')})()\n"}
