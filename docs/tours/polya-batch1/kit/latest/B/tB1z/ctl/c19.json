{"eval": "(async()=>{const w=ms=>new Promise(r=>setTimeout(r,ms));const R=JSON.parse(localStorage.getItem('mla.records.v1')||'{}');const L=Object.values(R).filter(r=>r&&r.type==='eprob'&&r.live).map(r=>r.p.id);APP.ASSIST.toggle(false);APP.go('lprob',L[L.length-1]);await w(1500);return [...document.querySelectorAll('#main button')].map(b=>b.textContent.trim().slice(0,40)).filter(t=>/حل|بست|✅/.test(t)).join(' | ')})()"}