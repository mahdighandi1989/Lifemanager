{"eval": "(async()=>{const b=[...document.querySelectorAll('#main button')].find(b=>b.textContent.trim()==='ثبتِ بازنگری');let box=b;for(let i=0;i<6&&box;i++)box=box.parentElement;return [...box.querySelectorAll('select,textarea,input')].map(x=>x.tagName+'#'+x.id+(x.tagName==='SELECT'?'['+[...x.options].map(o=>o.value+'='+o.textContent.slice(0,18)).join(';')+']':'')).join(' \\n ').slice(0,3500)})()"}