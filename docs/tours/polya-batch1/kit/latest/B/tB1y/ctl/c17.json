{"eval": "(()=>{const els=[...document.querySelectorAll(\"#main *\")].filter(e=>e.children.length==0&&/پرسیدم همان است/.test(e.innerText||\"\"));if(!els.length)return \"none\";let p=els[0];for(let i=0;i<3;i++)p=p.parentElement;return JSON.stringify({txt:p.innerText.slice(0,500),btn:[...p.querySelectorAll(\"button,a\")].map(b=>b.innerText.trim())})})()"}