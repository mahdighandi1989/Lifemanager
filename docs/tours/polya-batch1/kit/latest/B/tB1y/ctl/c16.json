{"eval": "(async()=>{const b=[...document.querySelectorAll(\"#main button, #main a\")].find(b=>/^❓ برگهٔ/.test(b.innerText.trim()));b.click();await new Promise(r=>setTimeout(r,2500));return JSON.stringify({view:location.hash,btn:[...document.querySelectorAll(\"#main button\")].map(b=>b.innerText.trim()).filter(t=>/نه|همان|بله|آره|✓|✗/.test(t)).slice(0,12),txt:document.getElementById(\"main\").innerText.split(\"\\n\").filter(l=>/❓|⏸|برگهٔ #/.test(l)).slice(0,6)})})()"}