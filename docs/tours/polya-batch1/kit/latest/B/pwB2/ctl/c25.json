{"eval": "(async()=>{const w=ms=>new Promise(r=>setTimeout(r,ms));const R=JSON.parse(localStorage.getItem('mla.records.v1')||'{}');const V=Object.values(R);const dl=V.filter(r=>r&&r.type==='deadline').map(r=>(r.what||r.title||'')+'@'+(r.date||r.due||''));const s=APP.ASSIST.cur();const pl=((s.coach||{}).plans||[]).map(p=>p.id+':'+(p.text||'').slice(0,40)+'@'+(p.when||'')+'/'+(p.state||''));APP.ASSIST.toggle(false);APP.go('today');await w(1500);const t=document.getElementById('main').innerText.split('\\n').filter(l=>/📌|📅|مدیر|صاحب|شیراز|موعد|جمعه/.test(l)).slice(0,12);return JSON.stringify({dl,pl,today:t,date:APP.today()})})()"}