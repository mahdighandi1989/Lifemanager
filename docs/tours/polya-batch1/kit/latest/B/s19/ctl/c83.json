{"eval": "(async()=>{const w=ms=>new Promise(r=>setTimeout(r,ms));APP.ASSIST.toggle(false);APP.go(\"today\",null,null);await w(1000);{const el=[...document.querySelectorAll('#main *')].filter(e=>e.children.length<6&&e.getClientRects().length&&\"\\u0639\\u0631\\u0648\\u0633\\u06cc\".split('|').some(t=>e.textContent.includes(t))).pop();if(el)el.scrollIntoView({block:'center'});}await w(300);return location.hash+' '+APP.state.view+' '+(APP.state.arg||'')})()"}