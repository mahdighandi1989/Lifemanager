{"eval": "(()=>{const s=APP.ASSIST.cur();const m=s.msgs.find(m=>m.role==='user'&&/\u06f7\u06f5\u066b\u06f1/.test(m.text||''));const b=[...document.querySelectorAll('.as-panel *')].filter(e=>e.children.length<40&&/\u06f7\u06f5\u066b\u06f1/.test(e.textContent)&&/\u0647\u0641\u062a\u0647\u200c\u06cc \u0647\u0634\u062a\u0645/.test(e.textContent)).pop();let bub=b;while(bub&&!bub.querySelector('svg')&&bub.parentElement&&!bub.classList.contains('as-panel'))bub=bub.parentElement;const svg=bub&&bub.querySelector('svg');return JSON.stringify({text:m&&m.text,corr:m&&m.corr,textHist:m&&m.textHist,svgText:svg?[...svg.querySelectorAll('text')].map(t=>t.textContent).join(' '):null,corrSpan:bub&&bub.querySelector('.as-corr')?bub.querySelector('.as-corr').textContent:null})})()\n"}
