{"eval": "(async()=>{const P=document.querySelector('.as-panel');const box=[...P.querySelectorAll('*')].filter(e=>/این‌جا هم عوض شود/.test(e.textContent)&&e.children.length<12&&e.querySelector('button')).pop();if(!box)return 'NOBOX';const b=[...box.querySelectorAll('button')].find(b=>/^(بله|آره|عوض)/.test(b.textContent.trim()));if(!b)return 'NOYES '+[...box.querySelectorAll('button')].map(b=>b.textContent).join('|');b.click();await new Promise(r=>setTimeout(r,1200));return 'clicked '+b.textContent.trim()})()"}