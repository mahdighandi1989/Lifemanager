{"eval": "(async()=>{const w=ms=>new Promise(r=>setTimeout(r,ms));APP.ASSIST.toggle(false);APP.go(\"today\");await w(2500);const t=document.getElementById(\"main\").innerText.split(\"\\n\").filter(l=>/📅|جمعه|پنجشنبه|آبان|🛎|⏸|🎯|پیش‌بینی|برگه/.test(l)).slice(0,25);const R=JSON.parse(localStorage.getItem(\"mla.records.v1\")||\"{}\");const V=Object.values(R);const dl=V.filter(r=>r&&/deadline|dl|plan/.test(r.type||\"\")).map(r=>(r.type+\":\"+JSON.stringify(r.p||r).slice(0,160)));const s=APP.ASSIST.cur();return JSON.stringify({today:t,dl:dl.slice(0,12),plans:(s.plans||s.coach&&s.coach.plans||[]),types:[...new Set(V.map(r=>r&&r.type))]})})()"}