{"eval": "(()=>{const R=JSON.parse(localStorage.getItem('mla.records.v1')||'{}');const V=Object.values(R);const o={};\no.probs=V.filter(r=>r&&r.type==='eprob'&&r.live).map(r=>{const s=r.solve||{};let cl=null;try{cl=APP.liveClosure(r.p.id)}catch(e){}return {pid:r.p.id,t:r.title,stmt:(r.p.statement||'').slice(0,200),fixHist:r.fixHist||r.p.fixHist||null,g:s.g&&s.g[1]&&{g:s.g[1].guess||s.g[1].g,fixHist:s.g[1].fixHist},u1:s.u&&s.u[1]&&{one:s.u[1].one,fixHist:s.u[1].fixHist},L:r.L&&{chat:r.L.chat&&{sol:(r.L.chat.solution||'').slice(0,200),verdict:r.L.chat.verdict,verdictHist:r.L.chat.verdictHist,fixHist:r.L.chat.fixHist},lesson:r.L.lesson,plan:r.L.plan,retracts:r.L.retracts,fixHist:r.L.fixHist},b:s.b&&s.b[1]&&{lesson:s.b[1].lesson,fixHist:s.b[1].fixHist},closure:cl&&{label:cl.label,verdict:cl.verdict,state:cl.state},steps:(s.e&&s.e[1]&&s.e[1].steps||[]).map(x=>({t:(x.t||x.text||'').slice(0,80),out:x.out,fixHist:x.fixHist}))}});\no.sess=V.filter(r=>r&&r.type==='achat').map(s=>({id:s.id,retracts:s.retracts,coachRetr:s.coach&&s.coach.retracts,plans:s.coach&&s.coach.plans,guess:s.coach&&s.coach.guess,last:(s.msgs||[]).slice(-3).map(m=>m.role+': '+(m.text||'').slice(0,160)+(m.textHist?' [HIST '+JSON.stringify(m.textHist).slice(0,200)+']':''))}));\ntry{o.mind=APP.MIND.phases().rows.map(r=>r.id+':'+r.k+'/'+r.n)}catch(e){o.mind=String(e)}\ntry{o.acts=APP.MIND.phases().rows.map(r=>r.id+'=> '+(r.acts||[]).map(a=>(a.ok?'+':'-')+(a.wd?'WD':'')+(a.fa||a.id||'').slice(0,70)).join(' | '))}catch(e){}\nreturn JSON.stringify(o,null,0)})()\n"}
