{"eval": "(async()=>{const W=ms=>new Promise(r=>setTimeout(r,ms));const p=(window.__PID||localStorage.getItem('__PID')||APP.state.arg||((APP.liveAll().slice(-1)[0]||{p:{}}).p.id));APP.go('lprob',p);await W(1200);const c=document.querySelector('.lp-syscard');const all=(APP.PRE&&APP.PRE.sysAll?APP.PRE.sysAll():[]).map(x=>({n:x.e.number,st:x.e.state,step:x.e.step,stepBy:x.e.stepBy,checks:(x.e.checks||[]).map(c=>c.reason).slice(-2),tool:x.e.tool}));return 'SYSCARD='+(c?c.innerText:'NONE')+' || SYS='+JSON.stringify(all)})()"}