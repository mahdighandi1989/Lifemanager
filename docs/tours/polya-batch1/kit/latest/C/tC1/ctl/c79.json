{"shot": {"name": "route_w104_hover", "full": false, "js": "(()=>{const L=[...document.querySelectorAll('.rt-pt')];const g=L.pop()||[...document.querySelectorAll('.rt-pt')].pop();if(!g)return 'NO PT';g.scrollIntoView({block:'center'});g.dispatchEvent(new Event('mouseenter'));const t=document.querySelector('.rt-tip');return g.getAttribute('aria-label')+' || '+(t?t.innerText:'')})()"}}