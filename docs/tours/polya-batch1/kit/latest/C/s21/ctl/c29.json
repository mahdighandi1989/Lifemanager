{"eval": "(async()=>{const W=ms=>new Promise(r=>setTimeout(r,ms));APP.ASSIST.toggle(true);await W(800);const b=document.querySelector('.as-msg .mx-board');if(!b)return 'NOBOARD msgs='+document.querySelectorAll('.as-msg').length+' sessions?';b.scrollIntoView({block:'center'});await W(300);const sq=[...b.querySelectorAll('[data-sq]')].filter(x=>x.textContent).map(x=>x.getAttribute('data-sq')+x.textContent).join(' ');return 'BOARD '+sq+' || '+b.innerText.slice(-20)+' || plots='+document.querySelectorAll('.as-msg .mx-plot').length+' || msg='+b.closest('.as-msg').innerText.slice(0,160);})()"}