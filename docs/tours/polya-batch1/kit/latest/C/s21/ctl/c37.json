{"eval": "(()=>{const o=[];APP.ASSIST.sessions().forEach(s=>(s.msgs||[]).forEach((m,i)=>{const t=m.text||'';const se=APP.MATH.series(t),f=APP.MATH.fen(t),segs=(APP.MATH.segments?APP.MATH.segments(t):[]);const mx=Array.isArray(segs)?segs.filter(x=>x&&x.m).map(x=>x.src||x.text||x.tex||JSON.stringify(x).slice(0,60)):[];if(se||f)o.push(m.role+' PLOT/FEN '+(se?JSON.stringify(se).slice(0,80):'')+(f?' FEN':'')+' :: '+t.slice(0,80));if(mx.length)o.push(m.role+' MATH '+mx.slice(0,6).join(' ¦ ').slice(0,200));}));return o.join('\\n')||'none';})()"}