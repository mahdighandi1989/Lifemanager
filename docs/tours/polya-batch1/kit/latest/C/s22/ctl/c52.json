{"eval": "(async()=>{const W=ms=>new Promise(r=>setTimeout(r,ms));APP.ASSIST.toggle(false);APP.go('today');await W(1500);const t=document.querySelector('#main').innerText;const i=t.indexOf('📌');const b=[...document.querySelectorAll('#main *')].find(x=>x.children.length===0&&/📌/.test(x.textContent));if(b)b.scrollIntoView({block:'center'});return 'TODAY='+APP.today()+' PIN '+(i<0?'none':t.slice(i,i+300));})()"}