{"shot": {"name": "pw1_route_hover_wait", "full": false, "js": "(()=>{const L=[...document.querySelectorAll('.rt-pt')];const g=L.pop();if(!g)return 'NO PT';const r=g.getBoundingClientRect();g.dispatchEvent(new MouseEvent('mouseover',{bubbles:true,clientX:r.x+3,clientY:r.y+3}));g.dispatchEvent(new MouseEvent('mouseenter',{bubbles:true}));return 'hover '+(g.getAttribute('data-k')||g.textContent||'').slice(0,40)})()"}}