{"eval": "(()=>{const o=[];APP.liveAll().forEach(r=>{try{const d=APP.dossier(r.p.id);const c=APP.liveClosure(r.p.id)||{};o.push('## '+r.p.title+' ['+(c.state||'')+'/'+APP.livePhase(r.p.id)+']\\n'+(d.events||[]).map(e=>'  '+e.k+' · '+String(e.title||'').slice(0,60)+' · '+String(e.text||e.body||e.sum||e.v||'').replace(/\\s+/g,' ').slice(0,110)).join('\\n'))}catch(e){o.push('ERR '+e.message)}});return o.join('\\n')})()"}