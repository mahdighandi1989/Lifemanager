{"shot": {"name": "route_oc_back_hover", "full": false, "js": "(()=>{const L=[...document.querySelectorAll('.rt-backjump')];const g=L.pop()||document.querySelector('.rt-pt');if(!g)return 'NO PT';g.scrollIntoView({block:'center'});g.dispatchEvent(new Event('mouseenter'));const t=document.querySelector('.rt-tip');return g.getAttribute('aria-label')+' || '+(t?t.innerText:'')})()"}}