{"eval": "(async()=>{const id=APP.liveAll().map(r=>r.p.id).pop();APP.ASSIST.toggle(false);APP.go('dossier',id);await new Promise(r=>setTimeout(r,1500));const m=document.getElementById('main');const x=[...m.querySelectorAll('*')].filter(e=>e.children.length<3&&/\u06a9\u0627\u0631\u0650 \u067e\u06cc\u0634\u06cc\u0646\u0650 \u062a\u0648/.test(e.textContent)).shift();if(x)x.scrollIntoView({block:'center'});return m.innerText.slice(0,9000)})()"}