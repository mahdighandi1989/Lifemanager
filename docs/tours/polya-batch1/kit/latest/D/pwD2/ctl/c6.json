{"eval": "(async()=>{const pn=document.querySelector('.as-panel');if(!pn||pn.hidden)APP.ASSIST.toggle(true);await new Promise(r=>setTimeout(r,800));const b=[...document.querySelectorAll('.as-msg,.as-bubble,.as-user')].slice(-3);if(b[0])b[0].scrollIntoView({block:'start'});return (document.querySelector('.as-panel')||{}).innerHTML.length+' math:'+document.querySelectorAll('.as-panel .katex,.as-panel .mx,.as-panel math,.as-panel .as-math').length})()"}