{"eval": "(()=>{const o=[];APP.PRE.sysAll().forEach(x=>{o.push(\"SHEET \"+x.e.number+\" \"+x.e.state+\" \"+(x.e.how||\"\"));(x.e.checks||[]).forEach(c=>o.push(\"   \"+(c.verdict||c.v||\"\")+\": \"+(c.reason||\"\").slice(0,120).replace(/\\n/g,\" \")))});o.push(\"---CHAT\");APP.S.all(\"achat\",x=>x&&x.msgs).forEach(s=>s.msgs.forEach(m=>{if(m.role==\"sys\"&&/🛎|❓|برگه|ابزار/.test(m.text))o.push(\"  \"+m.text.slice(0,180).replace(/\\n/g,\" \"))}));o.push(\"---DUE\");(APP.dueList()||[]).forEach(x=>{if(/برگه|ابزار|❓|🛎/.test(x.txt))o.push(\"  \"+x.txt.slice(0,150))});return o.join(\" ¶ \")})()"}
