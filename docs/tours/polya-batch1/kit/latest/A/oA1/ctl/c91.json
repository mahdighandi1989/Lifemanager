{"eval": "(()=>{APP.PRE.sysSweep(true);const o=[];APP.PRE.sysAll().forEach(x=>o.push(\"SHEET \"+x.e.number+\" \"+x.e.state+\" \"+((x.e.checks||[]).slice(-1).map(c=>c.reason).join(\"\")).slice(0,200)));APP.S.all(\"achat\",x=>x&&x.msgs).forEach(s=>s.msgs.slice(-40).forEach(m=>{if(m.role==\"sys\"&&/برگه|#۱۰۱/.test(m.text))o.push(\"  \"+m.text.slice(0,200))}));(APP.dueList()||[]).forEach(x=>{if(/برگه|ابزار|سنجش/.test(x.txt))o.push(\"DUE \"+x.txt.slice(0,150))});return o.join(\" ¶ \")})()"}
