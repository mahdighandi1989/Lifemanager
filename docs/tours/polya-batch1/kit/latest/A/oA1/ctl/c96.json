{"eval": "(()=>{APP.go(\"today\");const rows=[...document.querySelectorAll(\"#main *\")].filter(e=>/پنج‌شنبه رسماً جواب می‌دم/.test(e.textContent)&&e.querySelector&&e.querySelector(\"button\"));const r=rows[rows.length-1];if(!r)return \"NOROW\";const b=[...r.querySelectorAll(\"button\")].find(b=>b.textContent.trim()==\"نه\");if(!b)return \"NOBTN \"+r.innerText.slice(0,200);b.click();return \"clicked\"})()"}
