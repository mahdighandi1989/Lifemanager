{"eval": "(async()=>{const s=[...document.querySelectorAll(\".as-panel svg\")];const m=s[0].closest(\".as-msg\");m.scrollIntoView({block:\"center\"});const b=[...m.querySelectorAll(\"button\")].find(b=>/افزودن/.test(b.textContent));if(!b)return \"NOADD \"+m.innerText.slice(0,300);b.click();await new Promise(r=>setTimeout(r,300));const ins=[...m.querySelectorAll(\"input\")];return ins.map(i=>(i.getAttribute(\"aria-label\")||i.placeholder)).join(\" | \")+\" || \"+m.innerText.slice(0,400)})()"}