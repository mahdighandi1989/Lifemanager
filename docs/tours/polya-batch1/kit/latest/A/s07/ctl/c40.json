{"eval": "(()=>{const ms=[...document.querySelectorAll(\".as-msg, .as-bubble, [class*=as-m]\")];const s=[...document.querySelectorAll(\".as-panel svg\")];return ms.length+\" msgs; svgs \"+s.length+\"\\n\"+s.map(x=>{const m=x.closest(\"[class*=as-]\");return (m?m.className:\"?\")+\" :: \"+[...x.querySelectorAll(\"text\")].map(t=>t.textContent).join(\",\").slice(0,200)}).join(\"\\n\")})()"}
