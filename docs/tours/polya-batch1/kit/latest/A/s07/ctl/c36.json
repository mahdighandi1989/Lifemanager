{"eval":"(()=>{const pn=document.querySelector('.as-panel');if(!pn||pn.hidden)APP.ASSIST.toggle(true);const ms=[...document.querySelectorAll('.as-msg')];const out=ms.map((m,i)=>i+':'+m.className+' svg='+m.querySelectorAll('svg').length+' plot='+(m.querySelector('[class*=plot]')?m.querySelector('[class*=plot]').className+' '+(m.querySelector('[class*=plot]').textContent||'').slice(0,200):''));const t=ms.find(m=>m.querySelector('svg'));if(t)t.scrollIntoView({block:'start'});return out.join(' ## ')})()"}
