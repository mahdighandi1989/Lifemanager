{"eval": "(()=>{APP.ASSIST.toggle(true);const ms=[...document.querySelectorAll(\".as-msg\")];return ms.map((m,i)=>{const p=m.querySelectorAll(\"svg\");return p.length?i+\":\"+m.className.split(\" \").join(\".\")+\" svgs=\"+p.length+\" ticks=\"+[...m.querySelectorAll(\"svg text\")].map(t=>t.textContent).slice(0,14).join(\",\")+\" | \"+m.innerText.slice(0,80):null}).filter(Boolean).join(\"\\n\")})()"}