{"eval": "(async()=>{APP.ASSIST.toggle(true);document.body.appendChild(document.createElement(\"div\"));await new Promise(r=>setTimeout(r,400));const m=document.querySelectorAll(\".as-msg\")[0];m.scrollIntoView({block:\"start\"});const sv=m.querySelector(\"svg\");return (m.innerText.slice(0,120))+\" || ticks=\"+(sv?[...sv.querySelectorAll(\"text\")].map(t=>t.textContent).join(\",\"):\"nosvg\")+\" | marked=\"+(m.className)})()"}