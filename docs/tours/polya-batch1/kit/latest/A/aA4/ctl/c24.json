{"eval": "(()=>{const m=document.getElementById(\"main\");const i=[...m.querySelectorAll(\"input\")].find(i=>(i.getAttribute(\"aria-label\")||\"\").includes(\"تاریخِ تولد\"));i.scrollIntoView({block:\"center\"});i.value=\"۱۳۲۴/۴/۵۱\";i.dispatchEvent(new Event(\"input\",{bubbles:true}));i.dispatchEvent(new Event(\"change\",{bubbles:true}));const b=i.parentElement.querySelector(\"button\")||i.closest(\"div,p,section\").querySelector(\"button\");if(b)b.click();const box=i.closest(\"section,div,p\");return \"btn=\"+(b?b.innerText:\"none\")+\" birth=\"+APP.AGE.birth()+\" | \"+(box?box.innerText.slice(0,400):\"\")})()"}