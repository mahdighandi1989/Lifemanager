{"eval": "(()=>{APP.go(\"mind\");document.querySelectorAll(\"details\").forEach(d=>{d.open=true});const m=document.getElementById(\"main\");const ins=[...m.querySelectorAll(\"input\")].filter(i=>/تولد|birth|age/i.test((i.className||\"\")+(i.placeholder||\"\")+(i.getAttribute(\"aria-label\")||\"\")));return ins.map(i=>i.className+\"|\"+i.placeholder+\"|\"+i.getAttribute(\"aria-label\")+\"|\"+i.value).join(\"\\n\")+\"\\nPSY:\"+(m.innerText.match(/سن:[^\\n]*/)||[\"\"])[0]})()"}