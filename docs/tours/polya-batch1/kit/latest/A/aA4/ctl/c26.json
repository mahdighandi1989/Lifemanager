{"eval": "(()=>{const m=document.getElementById(\"main\");const i=[...m.querySelectorAll(\"input\")].find(i=>(i.getAttribute(\"aria-label\")||\"\").includes(\"تاریخِ تولد\"));let p=i.parentElement;for(let k=0;k<3&&p&&p.innerText.length<60;k++)p=p.parentElement;const live=[...document.querySelectorAll(\"[aria-live],[role=status],.toast\")].map(e=>e.textContent.trim()).filter(Boolean).slice(-4);return \"val=\"+i.value+\" | box=\"+(p?p.innerText.slice(0,500):\"\")+\" | live=\"+JSON.stringify(live)})()"}