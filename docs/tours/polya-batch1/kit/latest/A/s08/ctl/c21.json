{"eval": "(()=>{const c=[...document.querySelectorAll(\"#main *\")].find(e=>/^بازنگری: /.test((e.textContent||\"\").trim())&&e.children.length<2);const box=c&&c.closest(\"div,section\");const b=box&&box.parentElement;return b?[...b.querySelectorAll(\"textarea,select,button,input\")].map(e=>e.tagName+\"#\"+e.id+\"[\"+(e.getAttribute(\"aria-label\")||e.textContent||\"\").slice(0,60)+\"]\").join(\" | \"):\"none\"})()"}