# Environment Variables for LifeManager
# Copy this file to .env and replace every <PLACEHOLDER> with a real value.
# On Render these are injected via the dashboard / render.yaml.
# DO NOT commit a populated .env to git (.gitignore already covers it).

# Deployment environment. When set to "production", the app refuses to start
# unless JWT_SECRET_KEY is also set to something other than the dev default.
ENVIRONMENT=development

# JWT signing key for access tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# IMPORTANT: rotating this value invalidates all outstanding tokens.
JWT_SECRET_KEY=<YOUR_JWT_SECRET_KEY>

# JWT algorithm + access token TTL (minutes).
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Strict-auth switch (security task 9a5a3b4d). When false (default) a request
# with NO Authorization header falls back to the single-tenant anon scope so
# the current login-bypass frontend keeps working. A forged/expired bearer is
# ALWAYS rejected on the sensitive routes (finance/assets/context) regardless.
# Flip to true AFTER migrating the legacy user-0 data to real accounts to
# refuse anonymous access entirely.
REQUIRE_AUTH=false

# کد دعوت ثبت‌نام — وقتی ست شود، POST /register بدون همین کد 403 می‌دهد و
# ثبت‌نامِ باز روی URL عمومی بسته می‌شود. خالی = رفتار فعلی (ثبت‌نام آزاد).
REGISTER_INVITE_CODE=

# Per-IP rate limits for auth endpoints (slowapi syntax: <count>/<period>).
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/hour
# Set to true ONLY in tests where determinism matters.
RATE_LIMIT_DISABLED=false

# Database URL (PostgreSQL with asyncpg).
# Render's Postgres add-on exposes DATABASE_URL with the legacy "postgres://"
# scheme; the app normalizes it to "postgresql+asyncpg://" at startup.
DATABASE_URL=postgresql+asyncpg://<YOUR_DB_USER>:<YOUR_DB_PASSWORD>@<YOUR_DB_HOST>:5432/<YOUR_DB_NAME>

# Redis URL — used as both cache and Celery broker.
REDIS_URL=redis://<YOUR_REDIS_HOST>:6379/0
# Celery broker (defaults to REDIS_URL if unset).
CELERY_BROKER_URL=redis://<YOUR_REDIS_HOST>:6379/0

# How often (minutes) the periodic file-source sync runs — celery beat
# re-checks indexed file/asset paths and prunes the ones deleted on disk
# (task 217909d2, Step 2 / AC3). Default 30.
FILE_SYNC_INTERVAL_MINUTES=30

# How often (minutes) the per-user context analysis runs (celery beat) — it
# fuses each user's location/heart-rate/idle signals into recommendations and
# fires a proactive in-app notification (task 2165524b). Default 15.
CONTEXT_ANALYSIS_INTERVAL_MINUTES=15
# Minutes of no recorded activity after which the engine infers the user is
# idle/bored and nudges an open task. Default 60.
CONTEXT_IDLE_MINUTES=60

# Application port
PORT=8000

# Connection pool tuning.
# Defaults give 20 persistent + 80 overflow = 100 concurrent capacity.
# Lower these (e.g. POOL_SIZE=10, MAX_OVERFLOW=20) on shared/free-tier Postgres
# instances where total connection limit is ~100.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=80
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# CORS allowed origins (comma-separated). Wildcard '*' is intentionally not
# accepted — list every front-end origin explicitly.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Outgoing HTTP call timeout in seconds (used by integration_service /
# webhook delivery / AI provider calls).
EXTERNAL_API_TIMEOUT=30

# Feature flags — default false so a fresh deploy can't accidentally turn on
# half-built surface area. Flip to true to enable.
FEATURE_AI_ENABLED=false
FEATURE_INTEGRATIONS_ENABLED=false
# Identity-document extraction surface (Emirates ID — task 32ade384). Default
# false; the routes stay mounted, this gates UI exposure of the surface.
FEATURE_IDENTITY_DOCS_ENABLED=false

# When true AND ENVIRONMENT != production, startup runs `alembic upgrade head`
# automatically (audit task 3ea5622b). Off by default; production never
# auto-migrates — run migrations as a controlled deploy step there.
RUN_ALEMBIC_MIGRATIONS_ON_STARTUP=false

# Optional: AI provider API key. Leave the placeholder to use the
# deterministic offline placeholder instead of a live upstream.
OPENAI_API_KEY=<YOUR_OPENAI_API_KEY>

# Hallucination guard (audit task 32145cd6). Every answer the ai_llm pipeline
# produces is scored for confidence + internal consistency + grounding; answers
# scoring below the threshold are flagged for human review (GET
# /api/ai/hallucination-flags) instead of being shown silently as fact.
# AI_HALLUCINATION_DETECTION_ENABLED — master switch (default true).
# AI_HALLUCINATION_CONFIDENCE_THRESHOLD — 0..1; below this => flagged (default 0.5).
# AI_HALLUCINATION_REVIEW_QUEUE_MAX — max in-process flagged items kept (default 200).
AI_HALLUCINATION_DETECTION_ENABLED=true
AI_HALLUCINATION_CONFIDENCE_THRESHOLD=0.5
AI_HALLUCINATION_REVIEW_QUEUE_MAX=200

# HMAC secret used to verify incoming /webhook POSTs. Per-provider
# overrides are looked up as WEBHOOK_SECRET_<PROVIDER> (e.g.
# WEBHOOK_SECRET_GITHUB) before falling back to this generic value.
WEBHOOK_SECRET=<YOUR_WEBHOOK_SECRET>

# Optional Google OAuth (only required when the /auth/google flow is
# enabled). Setting GOOGLE_CLIENT_ID is what makes app/main.py mount
# the auth_google router; without it the OAuth endpoints stay off the
# schema. GOOGLE_REDIRECT_URI must match the value registered in the
# Google Cloud Console (Authorized redirect URIs). The default below is
# the local dev callback the code falls back to
# (app/routes/auth_google.py) so a dev machine works as-is; replace it
# with your registered production URI for a real deployment (audit task
# a997baa8).
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Bootstrap admin email(s) — comma-separated. Accounts whose email matches
# (case-insensitive) are seeded with the admin role on first OAuth login and
# pass the admin gate (app/dependencies/auth.py). This replaces a hardcoded
# admin email that previously lived in source and bypassed role-based access
# control. Leave empty to start with no admin (grant the role in the DB
# instead); set it to seed the first admin on a fresh deploy. Example:
# ADMIN_EMAILS=owner@example.com,ops@example.com
ADMIN_EMAILS=

# ── Google Drive integration ────────────────────────────────────────────────
# The Drive connection is normally established from the UI: open Settings →
# «گوگل درایو» → "اتصال به گوگل درایو" (one-time OAuth consent). That stores an
# ENCRYPTED refresh_token in the DB (global_settings table) — you do NOT need to
# set a token env var for the UI flow. It requires GOOGLE_CLIENT_ID /
# GOOGLE_CLIENT_SECRET / GOOGLE_REDIRECT_URI above, and the Drive API + Sheets
# API enabled on the Google Cloud project, with the `drive.file` + `spreadsheets`
# scopes. Files land under a single app folder ("LifeManagerData").
#
# GOOGLE_DRIVE_REFRESH_TOKEN — optional override/fallback: a refresh_token wired
# directly via env (e.g. a headless/server script) instead of the UI consent
# flow. Empty by default; the UI-stored token takes precedence.
GOOGLE_DRIVE_REFRESH_TOKEN=

# OAuth refresh token for the central Google Sheet ledger (audit task 7367c6f0).
# Empty by default → sheets_service.record_index_entry is a no-op. The Drive
# connection above also satisfies the Sheets ledger, so this is only needed for
# a Sheets-only setup without the full Drive connection.
GOOGLE_SHEETS_REFRESH_TOKEN=

# Google Maps API key — only needed when the location/search
# geocoding endpoint goes live. Both the backend variable and the
# frontend Vite variable accept the same value. Leave the placeholder
# in dev to keep the surface gated off.
GOOGLE_MAPS_API_KEY=<YOUR_GOOGLE_MAPS_API_KEY>
VITE_GOOGLE_MAPS_API_KEY=<YOUR_GOOGLE_MAPS_API_KEY>

# Telegram bot — BIDIRECTIONAL (audit task 92fa5ea15e2b + telegram-bot-setup).
#  • Outbound: critical-event notifications fan out here (send_telegram → the
#    shared send_message_sync). When TELEGRAM_BOT_TOKEN is unset the bot logs +
#    no-ops, so verify_failed still persists in-app without a bot configured.
#  • Inbound: the bot answers commands/buttons via POST /api/telegram/webhook.
#    Register it once after deploy: POST /api/telegram/set-webhook (uses
#    BACKEND_PUBLIC_URL below), or let the 5-min self-heal supervisor do it.
# Get the token from @BotFather; get your chat id from @userinfobot (or /diag).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public origin of THIS backend — used to build the Telegram webhook URL
# (<BACKEND_PUBLIC_URL>/api/telegram/webhook) for set-webhook + the self-heal
# supervisor. On Render, RENDER_EXTERNAL_URL is set automatically and used as a
# fallback, so this is only needed for custom domains / non-Render hosts.
BACKEND_PUBLIC_URL=
# Which account-owner the bot's task reads/writes belong to (single-tenant
# default = 0, the anon bucket — mirrors FINANCE_INGEST_USER_ID).
TELEGRAM_TASK_USER_ID=0
# Optional SPA origin for the deep-link buttons in the bot's /menu. Falls back
# to BACKEND_PUBLIC_URL when empty.
TELEGRAM_APP_BASE_URL=

# Email notification channel (optional). The unified notification settings expose
# an "ایمیل" channel; when it's enabled AND this recipient is set, critical events
# (verify_failed / budget_alert) also email here via the existing SMTP_* config
# (send_email). Empty ⇒ the email channel is a clean no-op. Per-event/per-channel
# routing is stored in the global_settings table (key=notification_prefs), editable
# from Settings → «اعلان‌ها».
NOTIFICATION_EMAIL_TO=

# Per-event notification rate-limit (max fires per (user,event) per window-secs)
# — flood guard for the forged-webhook → verify_failed path. Defaults 60 / 60s.
EVENT_RATE_LIMIT_MAX=60
EVENT_RATE_LIMIT_WINDOW_S=60

# Live finance sources (audit task 4ae4b3ca). All empty by default → the
# process_finance_updates Celery puller is a clean no-op. Set FINANCE_IMAP_URL
# to a mailbox and the puller fetches UNSEEN bank/exchange emails every 30 min
# and feeds each through finance_ingest_service.apply_bank_message (update
# balance → record Transaction → affordable-task reminder). FINANCE_SMS_WEBHOOK
# is a *push* source: point your SMS gateway at POST /api/finance/ingest-message.
# FINANCE_INGEST_USER_ID is which account-owner pulled mail belongs to (single-
# tenant default = 0, the anon bucket).
# FINANCE_IMAP_URL=imaps://user:password@imap.host.com:993/INBOX
FINANCE_IMAP_URL=
FINANCE_SMS_WEBHOOK=
FINANCE_INGEST_USER_ID=0

DEBUG=false

# ── مرکز توسعه (dev-sync: GitHub repos + Render services/logs) ──────────────
# Tokens resolve DB-first (encrypted, set from the UI settings tab), then env.
# GITHUB_TOKEN: a GitHub PAT with read access to your repos (GH_TOKEN also works).
# RENDER_API_KEY: Render → Account Settings → API Keys.
GITHUB_TOKEN=
RENDER_API_KEY=
# Optional engine knobs (defaults shown; UI-saved settings override env):
# DEV_SYNC_ENABLED=1
# DEV_REPO_SYNC_INTERVAL_MINUTES=60
# DEV_SERVICE_SYNC_INTERVAL_MINUTES=30
# DEV_LOG_POLL_SECONDS=120
# DEV_LOG_FETCH_LIMIT=100
# DEV_LOG_RETENTION_HOURS=72
# DEV_SUMMARY_ENABLED=1
# DEV_SUMMARY_HOUR=22
# DEV_TZ_OFFSET_MINUTES=240

# ── گوگلِ من (personal Gmail/Calendar sync + گزارش روز) ─────────────────────
# Rides the SAME Google OAuth connection as Drive — after deploy, click
# «اتصال به گوگل» once in Settings → گوگل so the new gmail/calendar scopes
# get consented. Engine knobs (defaults shown; UI-saved settings override):
GOOGLE_SYNC_ENABLED=1
GOOGLE_SYNC_TZ_OFFSET_MINUTES=240
# GMAIL_POLL_MINUTES=30
# GMAIL_FETCH_LIMIT=25
# CALENDAR_POLL_MINUTES=60
# CALENDAR_WINDOW_DAYS=14
# PERSONAL_DIGEST_ENABLED=1
# PERSONAL_DIGEST_HOUR=21
# PERSONAL_DIGEST_EMAIL=1
# CALENDAR_REMIND_HOURS=24
# Digest email goes to NOTIFICATION_EMAIL_TO (or the connected account itself)
# via the Gmail API; SMTP_* is only the fallback transport:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# ── موتور واحد زمان‌بندی (jobs engine — phase 1) ──────────────────────────
# فاصلهٔ اجرای پیشنهادهای زمینه‌ای (دقیقه). پیش‌فرض 30.
CONTEXT_ANALYSIS_INTERVAL_MINUTES=30
# فاصلهٔ سرکشی ایمیل بانکی IMAP (دقیقه). پیش‌فرض 30؛ بدون FINANCE_IMAP_URL بی‌اثر.
FINANCE_POLL_INTERVAL_MINUTES=30
# خاموش‌کردن درز کاتالوگ AI و برگشت کامل به مسیر قدیمی OpenAI (اضطراری).
AI_LEGACY_ONLY=
