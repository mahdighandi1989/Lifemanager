# Render injects DATABASE_URL automatically when the DB is linked to the service.
# For local development, copy this file to .env and fill in real values.
DATABASE_URL=postgresql://user:password@localhost:5432/lifemanager

# Connection pool tuning (defaults are safe for Render free tier).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
