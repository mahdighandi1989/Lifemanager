# Environment Variables for LifeManager
# Copy this file to .env and fill in your values.
# On Render these are injected via the dashboard / render.yaml.

# Deployment environment. When set to "production", the app refuses to start
# unless JWT_SECRET_KEY is also set to something other than the dev default.
ENVIRONMENT=development

# JWT signing key for access tokens.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# IMPORTANT: rotating this value invalidates all outstanding tokens.
JWT_SECRET_KEY=dev-only-change-me-in-production

# JWT algorithm + access token TTL (minutes).
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Per-IP rate limits for auth endpoints (slowapi syntax: <count>/<period>).
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_REGISTER=3/hour
# Set to true ONLY in tests where determinism matters.
RATE_LIMIT_DISABLED=false

# Database URL (PostgreSQL with asyncpg)
# Render's Postgres add-on exposes DATABASE_URL with the legacy "postgres://"
# scheme; the app normalizes it to "postgresql+asyncpg://" at startup.
DATABASE_URL=postgresql+asyncpg://user:pass@localhost/dbname

# Redis URL (for Celery)
REDIS_URL=redis://localhost:6379/0

# Application port
PORT=8000

# Connection pool tuning.
# Defaults give 20 persistent + 80 overflow = 100 concurrent capacity.
# Lower these (e.g. POOL_SIZE=10, MAX_OVERFLOW=20) on shared/free-tier Postgres
# instances where total connection limit is ~100.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=80
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

DEBUG=false
